{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile everything",
            "type": "shell",
            "command": "javac --release 17 -d out (Get-ChildItem src,test -Recurse -Filter *.java).FullName",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$javac"]
        },
        {
            "label": "Run CTF Client Demo",
            "type": "shell",
            "command": "java -cp out ctf.client.Demo",
            "dependsOn": ["Compile everything"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run server (1 player to start)",
            "type": "shell",
            "command": "java -cp out ctf.server.GameServer 5000 1",
            "dependsOn": ["Compile everything"],
            "problemMatcher": []
        }
    ]
}
